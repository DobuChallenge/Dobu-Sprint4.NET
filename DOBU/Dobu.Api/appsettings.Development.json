{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DobuSqlite": "Data Source=dobu-development.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrations": false
  },
  "Jwt": {
    "Key": "dobu-development-signing-key-change-in-production-32chars"
  },
  "Observability": {
    "ExternalServiceUrl": "http://localhost:5000/status"
  },
  "Mongo": {
    "Enabled": true,
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "dobu"
  }
}
