{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Oracle",
    "ApplyMigrations": true
  },
  "Jwt": {
    "Key": ""
  },
  "ConnectionStrings": {
    "DobuOracle": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Observability": {
    "ExternalServiceUrl": "http://localhost:5000/status"
  },
  "Mongo": {
    "Enabled": true,
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "dobu"
  }
}
